# =============================================================================
# 집값노트 환경변수 (.env.example → .env 로 복사 후 값 입력)
#
# 주의: EXPO_PUBLIC_* 변수는 클라이언트 번들에 그대로 포함된다.
#       비밀로 유지해야 하는 값은 절대 EXPO_PUBLIC_* 에 넣지 않는다.
#       (MOLIT serviceKey의 클라이언트 노출 한계는 PRD 리스크 R-1로 관리 —
#        쿼터/도용 이슈 발생 시 프록시 전환)
# =============================================================================

# 목 데이터 스위치 (src/shared/config/env.ts)
# - 미설정 시: 개발 빌드(__DEV__)는 true, 프로덕션 빌드는 false
# - true  → shared/api/mocks 사용: API 키 없이 모든 화면 동작 (클론 직후 권장)
# - false → 국토교통부 실거래가 API 실호출 (아래 MOLIT 키 필수)
EXPO_PUBLIC_USE_MOCK=true

# 국토교통부 아파트 매매 실거래가 API serviceKey (디코딩된 키)
# 발급: https://www.data.go.kr → 회원가입 → "아파트 매매 실거래가 자료" 활용신청
#       → 마이페이지 > 인증키(Decoding) 복사 (신청 후 승인까지 1~2시간)
# EXPO_PUBLIC_USE_MOCK=false 로 실 API를 쓸 때만 필요
EXPO_PUBLIC_MOLIT_API_KEY=

# (선택) MOLIT API base URL — 기본은 data.go.kr 직접 호출.
# 키 도용/쿼터 이슈 시 프록시(Cloudflare Workers 등)로 전환할 때만 설정 (R-1)
# EXPO_PUBLIC_MOLIT_BASE_URL=https://apis.data.go.kr/1613000/RTMSDataSvcAptTrade
