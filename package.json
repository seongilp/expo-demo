    "react-native-worklets": "^0.7.3",
    "tailwindcss": "^3.4.19",
    "victory-native": "^41.26.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/node": "^25.9.3",
    "@types/react": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.55.0",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^9.25.0",
