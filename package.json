    "expo-system-ui": "~6.0.9",
    "expo-tracking-transparency": "~6.0.7",
    "fast-xml-parser": "^5.8.0",
    "nativewind": "^4.2.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-mobile-ads": "^16.3.1",
    "react-native-reanimated": "~4.1.1",
